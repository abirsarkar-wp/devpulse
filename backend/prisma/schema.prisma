generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  incidentsCreated Incident[] @relation("IncidentCreator")
  comments         Comment[]
  auditLogs        AuditLog[]
}

model Incident {
  id          String         @id @default(uuid())
  title       String
  description String
  status      IncidentStatus @default(OPEN)
  createdBy   String
  creator     User           @relation("IncidentCreator", fields: [createdBy], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  comments  Comment[]
  auditLogs AuditLog[]
}

model Comment {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  createdAt  DateTime @default(now())
}